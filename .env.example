# Copy to .env and fill in secrets. Never commit real keys.

# Gupshup
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=JuanCamiloTestBot
GUPSHUP_APP_ID=009b780e-e61b-4396-9cb2-d3faf84297eb
GUPSHUP_SOURCE=34637274292
WABA_ID=3666860806796820
PHONE_NUMBER_ID=1378713898668233

# Messaging provider: meta (Cloud API, default) or gupshup
PROVIDER=meta

# Meta Cloud API (leave secrets empty in git; set them on the host)
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v21.0

# If true, log outbound messages instead of calling Meta/Gupshup.
DRY_RUN=true

PORT=8080
HOST=0.0.0.0

# LLM (optional). If unset or no key is found, the rule-based fallback is used.
# Providers: openai, anthropic, xai, groq, openrouter, gemini, together, mistral, ollama
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# 
# Optional reserved Serveo subdomain (only after registering data/tunnel_ed25519.pub
# at https://console.serveo.net — free Google/GitHub login, not required).
# TUNNEL_SUBDOMAIN=jcdg-wa-xxxx

# smee.io is NOT used by default and must not be used for the real Gupshup webhook
# (publicly viewable channel + payload replay). Opt in only with USE_SMEE=1.
# SMEE_URL=

# Gupshup-only optional shared secret. If set, POST /webhook requires ?token=<value>.
WEBHOOK_TOKEN=
